; STANDARD MD INPUT OPTIONS FOR MARTINI 3.x
; Updated 30 Jan 2017 by PCTS
;
; for use with GROMACS 5

; TIMESTEP IN MARTINI 
; Default timestep of 20 fs. 

integrator               = md
dt                       = 0.02
nsteps                   = XSTEPS
nstcomm                  = 100
comm-grps		 = 

nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 5000
nstenergy                = 5000
nstxout-compressed       = 5000
compressed-x-precision   = 1000
compressed-x-grps        = 

cutoff-scheme            = Verlet
nstlist                  = 20
ns_type                  = grid
pbc                      = xyz
verlet-buffer-tolerance  = -1
rlist                    = 1.35

coulombtype              = reaction-field 
rcoulomb                 = 1.1
epsilon_r                = 15	; 2.5 (with polarizable water)
epsilon_rf               = 0
vdw_type                 = cutoff  
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1

tcoupl                   = v-rescale 
tc-grps                  = SYSTEM
tau_t                    = 1.0 
ref_t                    = 298 
Pcoupl                   = PCOUPL
Pcoupltype               = isotropic
tau_p                    = 12.0
compressibility          = 10e-4
ref_p                    = REFP

gen_vel                  = yes
gen_temp                 = 298
gen_seed                 = 473529

constraints              = none 
constraint_algorithm     = Lincs

lincs-iter               = 2
lincs-order              = 12


