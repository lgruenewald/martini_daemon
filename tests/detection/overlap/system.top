[moleculetype]
M_OV1 1
[atoms]
1 W 1 X X 1
2 W 1 X Y 1
3 W 1 X X 1

[bonds]
1 2 1 0.5 1000
2 3 1 0.5 1000

[moleculetype]
M_OV2 1
[atoms]
1 W 1 A A 1
2 W 1 A B 1
3 W 1 A C 1

[bonds]
1 2 1 0.5 1000
2 3 1 0.4 1000

[graph]
name g_ov1
atom x X W
atom y Y W
bond x y

; should never happen, always overlaps
[reaction]
ov1
[reactants]
g_ov1 g_ov1
[conditions]
; it's the same atom, actually
r_max 1:y 2:y 0.5

[graph]
name x
atom x A W

[graph]
name y
atom y B W

[graph]
name z
atom z C W

[reaction]
ov2
[reactants]
x y

[conditions]
r_max 1:x 2:y 0.7

[redefine]
2:y type TC5

; never happens because ov2 gets priority, since x has a lower atom index
; if in the future the order of reactions becomes less clearly defined, this test needs to be redone
[reaction]
ov3
[reactants]
y z
[conditions]
r_max 1:y 2:z 0.7
[redefine]
1:y type TC4
2:z type TC4

[system]
detection test with overlapping fragments

