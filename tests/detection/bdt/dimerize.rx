; reaction template file for BDT dithiol formation and breakage, with graphs

[frag]
name monomer
; the reacting atom
atom 1 BS* R_BEAD
; the atom used for building angles/dihedrals
atom 2 BNZ* B_BEAD
; BDT.itp has helper connections to build the graph
connection 1 2
; central atom, used to make the graphs on the same monomer overlap to prevent
; self reactions
atom 3 BNZ3 U
connection 1 3
; 1 cannot be bonded to another sulfur atom
atom! 4 BS* R_BEAD
bond 1 4

[frag]
name dimer
atom 1 BS* R_BEAD
atom 2 BS* R_BEAD
bond 1 2
equivalent 1 2

[ reaction ]
dimer_form
[ reactants ]
monomer monomer
[ conditions ]
r_max 1:1 2:1 0.37
; allowed angle near 120 deg, +- 15 deg
angle_not 1:2 1:1 2:1 0   105
angle_not 1:2 1:1 2:1 135 180
angle_not 2:2 2:1 1:1 0   105
angle_not 2:2 2:1 1:1 135 180
; allowed dihedral near 110 deg +- 20 deg
dihedral_not 1:2 1:1 2:1 2:2 130 90

[bonds]
; morse bond
; i j type=3 b(nm) D(kj/mol) beta(nm-1)
;  1:1 2:1   3    0.275   10        12

; harmonic bond
1:1 2:1 1 0.275 15000
[angles]
1:2 1:1 2:1 10 120 800
2:2 2:1 1:1 10 120 800

[dihedrals]
1:2 1:1 2:1 2:2 1 110 120 1

[ reaction ]
dimer_break
[ reactants ]
dimer
[ conditions ]
r_min 1:1 1:2 0.33664
[ break ]
1:1 1:2

