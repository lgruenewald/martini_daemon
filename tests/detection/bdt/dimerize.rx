; reaction template file for old BDT dithiol formation and breakage, with graphs

[frag]
name monomer
; the reacting atom
atom 1 BS* R_BEAD
; the atom used for building angles/dihedrals
atom 2 BNZ* B_BEAD
; BDT.itp has helper connections to build the graph
connection 1 2
; central atom, used to make the graphs on the same monomer overlap to prevent
; self reactions
atom 3 BNZ3 U
connection 1 3
; 1 cannot be bonded to another sulfur atom
atom! 4 BS* R_BEAD
bond 1 4

[frag]
name dimer
atom 1 BS* R_BEAD
atom 2 BS* R_BEAD
bond 1 2
equivalent 1 2

[ reaction ]
dimer_form
[ reactants ]
monomer monomer
[ conditions ]
r_max 1:1 2:1 0.37
; allowed angle near 120 deg, +- 15 deg
angle 1:2 1:1 2:1 105 to 135
angle 2:2 2:1 1:1 105 to 135
; allowed dihedral near 110 deg +- 20 deg
dihedral 1:2 1:1 2:1 2:2 90 to 130
