; Rx file for BDT dithiol formation and breakage

[frag]
monomer
[from]
; the mirror image is the same
BDT 1 2 3 4 5
BDT 2 1 3 5 4
; readd reactive ends on breaking
dimer_break 1 2 3 4 5
dimer_break 6 7 8 9 10

[ reaction ]
dimer
[ reactants ]
monomer monomer
[ conditions ]
; allowed distance below 0.4
r_max 1:5 2:5 0.35
; allowed angle near 120 deg, +- 20 deg
banned_angle 1:1 1:5 2:5 0 100
banned_angle 1:1 1:5 2:5 140 180
banned_angle 2:1 2:5 1:5 0 100
banned_angle 2:1 2:5 1:5 140 180

#define OLD
#ifdef OLD
[bonds]
; morse bond with arbitrary constants, not parametrized
; i j type=3 b(nm) D(kj/mol) beta(nm-1)
  1:5 2:5   3    0.275   10        12

[angles]
1:1 1:5 2:5 10 120 200
2:1 2:5 1:5 10 120 200
#else
[bonds]
; connection to visualize
1:5 2:5 5

[angles]
; morse bond coupled angle
2:5 1:5 1:1 101 120 200 0.275 5 12
1:5 2:5 2:1 101 120 200 0.275 5 12

[ exclusions ]
1:5 2:5
#endif

[dihedrals]
1:1 1:5 2:5 2:1 1 110 40 1

[ reaction ]
dimer_break
[ reactants ]
dimer
[ conditions ]
r_min 1:5 1:10 0.45
[ break ]
1:5 1:10
