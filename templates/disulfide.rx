; TLDR: REACTION TEMPLATE

; reaction definition
[ reaction ]
; breaks conventions of config files a little
name = thiol_dimerization
r1 = phthiol 
r2 = phthiol ; must bimolecular right now
p1 = DIM ; only one product right now
distance_max = 1.5 ; nm, distance cutoff

[ constraints ]
; todo: angle, reaction rate, etc constraints


[ mapping ]
; [reactant:functional group atom id] [product:atom id]
r1:1 p1:1
r1:2 p1:2
r1:3 p1:3
r1:4 p1:4
r2:1 p1:5
r2:2 p1:6
r2:3 p1:7
r2:4 p1:8

