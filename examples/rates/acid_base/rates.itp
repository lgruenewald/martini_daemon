[moleculetype]
AP 1
[atoms]
1 W 1 AP AP 1 +1

[moleculetype]
BM 1
[atoms]
1 W 1 BM BM 1 -1

[moleculetype]
W 1
[atoms]
1 W 1 W W 1 0

#ifdef DAEMON
[graph]
name AP
atom 1 AP *
[graph]
name A
atom 1 A *
[graph]
name BM
atom 1 BM *
[graph]
name B
atom 1 B *
[graph]
name WP
atom 1 WP *
[graph]
name WM
atom 1 WM *
[graph]
name W
atom 1 W *

; rate controlled reactions
; AP + W = A + WP
[reaction]
AP_W
[reactants]
AP W
[condition]
r_max 1:1 2:1 0.5
rate 10
[rename]
1:1 A
2:1 WP
[recharge]
1:1 0
2:1 1

[reaction]
A_WP
[reactants]
A WP
[condition]
r_max 1:1 2:1 0.5
rate 0.1
[rename]
1:1 AP
2:1 W
[recharge]
1:1 1
2:1 0

; BM + W = B + WM
[reaction]
BM_W
[reactants]
BM W
[condition]
r_max 1:1 2:1 0.5
rate 2
[rename]
1:1 B
2:1 WM
[recharge]
1:1 0
2:1 -1

[reaction]
B_WM
[reactants]
B WM
[condition]
r_max 1:1 2:1 0.5
rate 0.5
[rename]
1:1 BM
2:1 W
[recharge]
1:1 -1
2:1 0

; quick reactions with no rate control
; WP + WM -> W + W
[reaction]
WP_WM
[reactants]
WP WM
[condition]
r_max 1:1 2:1 0.5
[rename]
1:1 W
2:1 W
[recharge]
1:1 0
2:1 0

; AP + WM -> A + W
[reaction]
AP_WM
[reactants]
AP WM
[condition]
r_max 1:1 2:1 0.5
[rename]
1:1 A
2:1 W
[recharge]
1:1 0
2:1 0

; BM + WP -> B + W
[reaction]
BM_WP
[reactants]
BM WP
[condition]
r_max 1:1 2:1 0.5
[rename]
1:1 B
2:1 W
[recharge]
1:1 0
2:1 0
#endif
