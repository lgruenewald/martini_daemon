; referenced supporting information https://www.rsc.org/suppdata/d3/mh/d3mh00088e/d3mh00088e1.pdf

[ graph ]
name COOH_end
atom COOH COOH SP2 ; relies on retype to only match unreacted
atom CCR CCR1 TC5
vsite COOH CCR
; for renames
atom COH1 COH1 TN6
atom COH2 COH2 TN6
vsite COH1 CCR
vsite COH2 CCR

[ graph ]
name COH_A
atom COH COHA TN6 ; COH end, after rename
atom CCR CCR* TC5 ; directly connected backbone to COH
connection COH CCR
atom COH2 COHA TN6 ; other COHA end, for rename
vsite COH2 CCR

[ graph ]
name COH_B
atom COH COHB TN6 ; COH end, after second rename
atom CCR CCR* TC5
connection COH CCR

[ graph ]
name Br_end
atom CCB CCB* SX2 ; relies on retype to only match unreacted
atom CCA CCA TC2
bond CCA CCB

[ reaction ]
COOH_react
[ reactants ]
Br_end COOH_end
[ conditions ]
r_max 1:CCB 2:COOH 0.42
; 20 degree tolerance
angle_between 1:CCB 2:COOH 2:CCR 118 158
angle_between 1:CCA 1:CCB 2:COOH 113 153
rate 10
[ retype ]
1:CCB TC3
2:COOH SN4a
[ rename ]
2:COH1 COHA
2:COH2 COHA
[ bonds ]
1:CCB 2:COOH 1 0.2549 18000
[ angles ]
1:CCB 2:COOH 2:CCR 2 138 75
1:CCA 1:CCB 2:COOH 2 133 75

[ reaction ]
COH_A_react
[ reactants ]
Br_end COH_A
[ conditions ]
r_max 1:CCB 2:COH 0.42
angle_between 1:CCB 2:COH 2:CCR 118 158
angle_between 1:CCA 1:CCB 2:COH 113 153
rate 2
[ retype ]
1:CCB TC3
[ rename ]
2:COH COR
2:COH2 COHB
[ bonds ]
1:CCB 2:COH 1 0.2549 18000
[ angles ]
1:CCB 2:COH 2:CCR 2 138 75
1:CCA 1:CCB 2:COH 2 133 75


[ reaction ]
COH_B_react
[ reactants ]
Br_end COH_B
[ conditions ]
r_max 1:CCB 2:COH 0.42
angle_between 1:CCB 2:COH 2:CCR 118 158
angle_between 1:CCA 1:CCB 2:COH 113 153
rate 3
[ retype ]
1:CCB TC3
[ rename ]
2:COH COR
[ bonds ]
1:CCB 2:COH 1 0.2549 18000
[ angles ]
1:CCB 2:COH 2:CCR 2 138 75
1:CCA 1:CCB 2:COH 2 133 75
