; Rx file for BDT dithiol formation and breakage, with graphs

[frag]
monomer
[graph]
; the reacting atom
atom 1 BS* TC6
; the atom used for building angles/dihedrals
atom 2 BNZ* TC5
; BDT.itp has helper connections to build the graph
connection 1 2
; central atom, used to make the graphs on the same monomer overlap to prevent
; self reactions
atom 3 BNZ3 U
connection 1 3
; 1 cannot be bonded to another sulfur atom
atom! 4 BS* TC6
bond 1 4

[frag]
dimer
[graph]
atom 1 BS* TC6
atom 2 BS* TC6
bond 1 2
equivalent 1 2

[ rx ]
dimer_form
[ rx_reactants ]
monomer monomer
[ rx_products ]
dimer
[ rx_conditions ]
; 120% of bond length as bond cutoff
r_max 1:1 2:1 0.33
; allowed angle near 120 deg, +- 15 deg
banned_angle 1:2 1:1 2:1 0   105
banned_angle 1:2 1:1 2:1 135 180
banned_angle 2:2 2:1 1:1 0   105
banned_angle 2:2 2:1 1:1 135 180

#ifdef CRAZY
; do not define CRAZY atm
[bonds]
; connection to visualize
1:5 2:5 5

[angles]
; morse bond coupled angle
2:5 1:5 1:1 101 120 200 0.275 20 30
1:5 2:5 2:1 101 120 200 0.275 20 30

[ exclusions ]
1:5 2:5
#else
[bonds]
; morse bond
; REACTIVE MARTINI bond length was 0.28, this bond length was parametrized
; harmonic bond parametrized: 0.275 long, 15000 stiff
; beta of 30 reproduces the parametrized harmonic bond well thickness roughly
; D of 40 is the well depth observed
; i j type=3 b(nm) D(kj/mol) beta(nm-1)
  1:1 2:1   3    0.275   40        30
[angles]
1:2 1:1 2:1 10 120 200
2:2 2:1 1:1 10 120 200
#endif

[dihedrals]
1:2 1:1 2:1 2:2 1 110 40 1


[ rx ]
dimer_break
[ rx_reactants ]
dimer
[ rx_conditions ]
r_min 1:1 1:2 0.45
[ rx_break ]
1:1 1:2

