; Rx file for BDT dithiol formation and breakage

[frag]
monomer
[frag_from]
; the mirror image is the same
BDT 1 2 3 4 5
BDT 2 1 3 5 4
; readd reactive ends on breaking
dimer_break 1 2 3 4 5
dimer_break 6 7 8 9 10

[ rx ]
BDT_dimerization
[ rx_reactants ]
monomer monomer
[ rx_products ]
dimer
[ rx_conditions ]
; allowed distance below 0.4
r_max 5 10 0.35
; allowed angle near 120 deg, +- 20 deg
banned_angle 1 5 10 0 100
banned_angle 1 5 10 140 180
banned_angle 6 10 5 0 100
banned_angle 6 10 5 140 180
; allowed dihedral near 110 deg, +- 40 deg
; if uncommented, the reaction is really slow
; banned_dihedral 1 5 10 6 150 70

[ rx ]
BDT_dimer_breakage
[ rx_reactants ]
dimer
[ rx_products ]
dimer_break
[ rx_conditions ]
r_min 5 10 0.45
[ rx_break ]
5 10

[moleculetype]
dimer 1

[atoms]
1  TC5 1 BDT * 1 0 60
2  TC5 1 BDT * 2 0 60
3  U 1 BDT * 3 0 60
4  TC6 1 BDT * 4 0 0
5  TC6 1 BDT * 5 0 0
6  TC5 1 BDT * 6 0 60
7  TC5 1 BDT * 7 0 60
8  U 1 BDT * 8 0 60
9  TC6 1 BDT * 9 0 0
10 TC6 1 BDT * 10 0 0

[bonds]
; morse bond with arbitrary constants, not parametrized
; i j type=3 b(nm) D(kj/mol) beta(nm-1)
  5 10   3    0.275   10        12

[angles]
1 5 10 10 120 200
6 10 5 10 120 200

[dihedrals]
1 5 10 6 1 110 40 1

[moleculetype]
; placeholder type for readding dimers after dimer breakage
dimer_break 1

[atoms]
1  TC5 1 BDT * 1 0 60
2  TC5 1 BDT * 2 0 60
3  U 1 BDT * 3 0 60
4  TC6 1 BDT * 4 0 0
5  TC6 1 BDT * 5 0 0
6  TC5 1 BDT * 6 0 60
7  TC5 1 BDT * 7 0 60
8  U 1 BDT * 8 0 60
9  TC6 1 BDT * 9 0 0
10 TC6 1 BDT * 10 0 0
