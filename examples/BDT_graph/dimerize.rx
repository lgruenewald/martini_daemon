; Rx file for BDT dithiol formation and breakage, with graphs

[frag]
monomer
[graph]
; the reacting atom
atom 1 BS* TC6
; the atom used for building angles/dihedrals
atom 2 BNZ* TC5
; BDT.itp has helper connections to build the graph
connection 1 2
; central atom, used to make the graphs on the same monomer overlap to prevent
; self reactions
atom 3 BNZ3 U
connection 1 3
; 1 cannot be bonded to another sulfur atom
atom! 4 BS* TC6
bond 1 4

[ rx ]
BDT_dimerization
[ rx_reactants ]
monomer monomer
[ rx_products ]
dimer
[ rx_conditions ]
; allowed distance below 0.4
r_max 1 4 0.35
; allowed angle near 120 deg, +- 20 deg
banned_angle 2 1 4 0 100
banned_angle 2 1 4 140 180
banned_angle 5 4 1 0 100
banned_angle 5 4 1 140 180

[ rx ]
BDT_dimer_breakage
[ rx_reactants ]
dimer
[ rx_conditions ]
r_min 1 4 0.45
[ rx_break ]
1 4

[moleculetype]
dimer 1

[atoms]
1  TC6 1 BDT * 4 0 0
2  TC5 1 BDT * 1 0 60
3  U 1 BDT * 3 0 60
4 TC6 1 BDT * 10 0 0
5  TC5 1 BDT * 7 0 60
6  U 1 BDT * 8 0 60

[bonds]
; morse bond with arbitrary constants, not parametrized
; i j type=3 b(nm) D(kj/mol) beta(nm-1)
  1 4   3    0.275   10        12

[angles]
2 1 4 10 120 200
5 4 1 10 120 200

[dihedrals]
2 1 4 5 1 110 40 1
