# exclude .gro files, except in examples, tests and benchmarks
*.gro
!tests/**/*.gro
!examples/**/*.gro
!benchmarks/**/*.gro
# exclude all xyz and xtc trajectory files
*.xyz
*.xtc
# except truncation tests
!full.xtc
!reference.xtc
# exclude out files
out*
whole*
!whole.py
# exclude xvg from tests directory (energy.xvg, forces.xvg usually)
tests/**/*.xvg
# exclude logs
*.log
# exclude benchmark results
benchmarks/results
# exclude python cache
**/__pycache__/
# exclude backed up files
\#*
# exclude cargo lock
Cargo.lock
# exclude hidden files
.*
# include specific hidden files
!.gitignore
!.gitattributes
# exclude build products
build/*
martini_daemon.egg-info/*
dist/*
martini_daemon/**/*.c
build
martini_daemon.egg-info
dist
*.so
docs/build/*
docs/source/martini_daemon/*
target/*
!.readthedocs.yaml
